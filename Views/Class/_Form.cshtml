@model TutionCenter.Models.TuitionClass

<div class="card shadow-sm border-0">
    <div class="card-body p-4">

        <form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" method="post">

            <input asp-for="Id" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="row g-3">

                <!-- Class Code -->
                <div class="col-md-4">
                    <label asp-for="ClassCode" class="form-label"></label>
                    <input asp-for="ClassCode" class="form-control" />
                    <span asp-validation-for="ClassCode"
                          class="text-danger"></span>
                </div>

                <!-- Subject -->
                <div class="col-md-4">
                    <label asp-for="SubjectId" class="form-label"></label>

                    <select asp-for="SubjectId"
                            asp-items="ViewBag.Subjects"
                            class="form-select">
                        <option value="">Select a subject</option>
                    </select>

                    <span asp-validation-for="SubjectId"
                          class="text-danger"></span>
                </div>

                <!-- Teacher -->
                <div class="col-md-4">
                    <label asp-for="TeacherId" class="form-label"></label>

                    <select asp-for="TeacherId"
                            asp-items="ViewBag.Teachers"
                            class="form-select">
                        <option value="">Unassigned</option>
                    </select>

                    <span asp-validation-for="TeacherId"
                          class="text-danger"></span>
                </div>

                <!-- Day -->
                <div class="col-md-4">
                    <label asp-for="DayOfWeek" class="form-label"></label>

                    <select asp-for="DayOfWeek"
                            asp-items="ViewBag.Days"
                            class="form-select">
                        <option value="">Select a day</option>
                    </select>

                    <span asp-validation-for="DayOfWeek"
                          class="text-danger"></span>
                </div>

                <!-- Start Time -->
                <div class="col-md-4">
                    <label asp-for="StartTime" class="form-label"></label>
                    <input asp-for="StartTime"
                           class="form-control"
                           type="time" />

                    <span asp-validation-for="StartTime"
                          class="text-danger"></span>
                </div>

                <!-- End Time -->
                <div class="col-md-4">
                    <label asp-for="EndTime" class="form-label"></label>
                    <input asp-for="EndTime"
                           class="form-control"
                           type="time" />

                    <span asp-validation-for="EndTime"
                          class="text-danger"></span>
                </div>

                <!-- Room -->
                <div class="col-md-4">
                    <label asp-for="Room" class="form-label"></label>
                    <input asp-for="Room"
                           class="form-control" />

                    <span asp-validation-for="Room"
                          class="text-danger"></span>
                </div>

                <!-- Capacity -->
                <div class="col-md-4">
                    <label asp-for="Capacity" class="form-label"></label>
                    <input asp-for="Capacity"
                           class="form-control" />

                    <span asp-validation-for="Capacity"
                          class="text-danger"></span>
                </div>

                <!-- Active -->
                <div class="col-md-4 d-flex align-items-end">
                    <div class="form-check mb-2">
                        <input asp-for="IsActive"
                               class="form-check-input" />

                        <label asp-for="IsActive"
                               class="form-check-label"></label>
                    </div>
                </div>

            </div>

            <div class="mt-4">
                <button type="submit"
                        class="btn btn-primary">
                    Save Class
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary ms-1">
                    Cancel
                </a>
            </div>

        </form>

    </div>
</div>

<partial name="_ValidationScriptsPartial" />