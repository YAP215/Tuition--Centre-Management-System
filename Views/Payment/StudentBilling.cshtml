@model IEnumerable<TutionCenter.Models.Payment>

@{
    ViewData["Title"] = "Student Billing";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>💲 Student Billing</h2>
            <p class="text-muted">View your payment history</p>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            You do not have any payment records yet.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <style>
                        .student-billing-table thead th{
                            background-color:#c9dcf5;
                            color:black;
                        }
                    </style>
                    <table class="table table-hover student-billing-table">
                        <thead>
                            <tr>
                                <th>Payment Date</th>
                                <th>Amount</th>
                                <th>Payment Method</th>
                                <th>Status</th>
                                <th>Remarks</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        @item.PaymentDate.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        RM @item.Amount.ToString("0.00")
                                    </td>

                                    <td>
                                        @item.PaymentMethod
                                    </td>

                                    <td>
                                        @if (item.Status == "Paid")
                                        {
                                            <span class="badge bg-success">Paid</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                @item.Status
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @(string.IsNullOrEmpty(item.Remarks)
                                            ? "-"
                                            : item.Remarks)
                                    </td>
                                    <td>
                                        @if (item.Status == "Paid")
                                        {
                                            <a asp-action="DownloadReceipt"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-success">
                                                <i class="bi bi-file-earmark-pdf"></i>
                                                Receipt
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>