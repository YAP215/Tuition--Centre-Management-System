@model TutionCenter.Models.User

@{
    ViewData["Title"] = "Register";
}

<h2>Register</h2>

<form asp-action="Register" method="post">

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label>Name</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Password</label>
        <input asp-for="Password" type="password" class="form-control" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Account type</label>
        @if (ViewBag.CanCreateFirstAdmin == true)
        {
            <select asp-for="Role" class="form-control">
                <option value="Student">Student</option>
                <option value="Admin">Admin (first system administrator only)</option>
            </select>
            <small class="text-muted">Create the first Admin account now. After an Admin exists, public registration will create Student accounts only.</small>
        }
        else
        {
            <input class="form-control" value="Student" readonly />
            <input asp-for="Role" type="hidden" value="Student" />
            <small class="text-muted">Public registration creates a student account. Teachers are created by an administrator.</small>
        }
    </div>

    <button type="submit" class="btn btn-primary">
        Register
    </button>

</form>
