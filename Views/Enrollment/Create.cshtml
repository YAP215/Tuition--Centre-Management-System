@model TutionCenter.Models.EnrollmentCreateViewModel
@{ ViewData["Title"] = "Enroll Student"; }
<h2 class="text-primary fw-bold mb-4">Enroll Student</h2>
<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="StudentId" class="form-label"></label>
                <select asp-for="StudentId" asp-items="ViewBag.Students" class="form-select">
                    <option value="">Select a student</option>
                </select>
                <span asp-validation-for="StudentId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="TuitionClassId" class="form-label"></label>
                <select asp-for="TuitionClassId" asp-items="ViewBag.Classes" class="form-select">
                    <option value="">Select a class</option>
                </select>
                <span asp-validation-for="TuitionClassId" class="text-danger"></span>
            </div>
            <button class="btn btn-primary">Enroll Student</button>
            <a asp-action="Index" class="btn btn-outline-secondary ms-1">Cancel</a>
        </form>
    </div>
</div>

<partial name="_ValidationScriptsPartial" />