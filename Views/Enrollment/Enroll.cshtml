@model IEnumerable<TutionCenter.Models.TuitionClass>

@{
    ViewData["Title"] = "Enroll a Subject";
}

<div class="mb-4">
    <h2 class="text-primary fw-bold mb-1">
        Enroll a Subject
    </h2>

    <p class="text-muted mb-0">
        Choose an open class below. A class may be selected only once.
    </p>
</div>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">
        @error
    </div>
}

<div class="row g-3">
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="alert alert-info">
                There are no available classes at the moment.
            </div>
        </div>
    }

    @foreach (var item in Model)
    {
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <span class="badge text-bg-primary mb-2">
                                @item.Subject?.SubjectCode
                            </span>

                            <h5>
                                @item.Subject?.Name
                            </h5>
                        </div>

                        <strong>
                            RM @item.Subject?.MonthlyFee.ToString("N2")
                        </strong>
                    </div>

                    <p class="mb-1">
                        🗓️ @item.DayOfWeek,
                        @item.StartTime.ToString("HH:mm") -
                        @item.EndTime.ToString("HH:mm")
                    </p>

                    <p class="mb-3">
                        📍 @item.Room
                        &nbsp;
                        👨‍🏫 @(item.Teacher?.Name ?? "Teacher pending")
                    </p>

                    <form asp-action="Enroll" method="post">
                        <input type="hidden"
                               name="tuitionClassId"
                               value="@item.Id" />

                        <button class="btn btn-success">
                            Enroll Now
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>