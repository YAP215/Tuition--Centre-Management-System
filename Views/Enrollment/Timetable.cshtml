@model IEnumerable<TutionCenter.Models.StudentTimetableViewModel>

@{
    ViewData["Title"] = "My Timetable";

    string[] days =
    {
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
        "Sunday"
    };
}

<style>
    .timetable-header {
        margin-bottom: 28px;
    }

    .timetable-title {
        font-size: 30px;
        font-weight: 700;
        margin-bottom: 4px;
        color: #1f2937;
    }

    .timetable-subtitle {
        color: #6b7280;
        margin-bottom: 0;
    }

    .day-card {
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        background: #ffffff;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.05);
        height: 100%;
        overflow: hidden;
    }

    .day-header {
        padding: 14px 18px;
        background: #f8fafc;
        border-bottom: 1px solid #e5e7eb;
    }

        .day-header h5 {
            margin: 0;
            font-size: 17px;
            font-weight: 700;
            color: #1f2937;
        }

    .day-body {
        padding: 14px;
        min-height: 270px;
    }

    .class-card {
        border: 1px solid #e5e7eb;
        border-radius: 11px;
        padding: 15px;
        margin-bottom: 12px;
        background: #ffffff;
        transition: all 0.2s ease;
    }

        .class-card:last-child {
            margin-bottom: 0;
        }

        .class-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 14px rgba(0, 0, 0, 0.08);
            border-color: #cbd5e1;
        }

    .subject-code {
        font-size: 15px;
        font-weight: 700;
        color: #2563eb;
        margin-bottom: 2px;
    }

    .subject-name {
        font-size: 16px;
        font-weight: 600;
        color: #111827;
        margin-bottom: 10px;
    }

    .class-divider {
        border: 0;
        border-top: 1px solid #e5e7eb;
        margin: 10px 0 12px 0;
    }

    .time-badge {
        display: inline-block;
        padding: 6px 10px;
        border-radius: 7px;
        background: #eff6ff;
        color: #1d4ed8;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 11px;
    }

    .class-info {
        font-size: 13px;
        color: #4b5563;
        margin-bottom: 6px;
    }

        .class-info:last-child {
            margin-bottom: 0;
        }

        .class-info strong {
            color: #374151;
        }

    .empty-day {
        min-height: 240px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: #9ca3af;
        font-size: 14px;
    }

    .empty-day-icon {
        font-size: 25px;
        margin-bottom: 6px;
        opacity: 0.7;
    }

    .schedule-summary {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 13px;
        background: #f3f4f6;
        border-radius: 8px;
        color: #4b5563;
        font-size: 13px;
        margin-top: 12px;
    }

    @@media (max-width: 768px) {
        .timetable-title {
            font-size: 24px;
        }

        .day-body {
            min-height: auto;
        }

        .empty-day {
            min-height: 120px;
        }
    }
</style>

<div class="container-fluid">

    <!-- Header -->
    <div class="timetable-header">

        <h2 class="timetable-title">
            📅 My Weekly Timetable
        </h2>

        <p class="timetable-subtitle">
            View your weekly class schedule, including class time, room and teacher.
        </p>

        <div class="schedule-summary">
            📚
            <span>
                <strong>@Model.Count()</strong>
                active @(Model.Count() == 1 ? "class" : "classes")
            </span>
        </div>

    </div>


    @if (!Model.Any())
    {
        <!-- No Classes -->
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">

                <div style="font-size: 50px;">
                    📅
                </div>

                <h5 class="fw-bold mt-3">
                    No Classes Scheduled
                </h5>

                <p class="text-muted mb-0">
                    You currently have no active enrolled classes.
                </p>

            </div>
        </div>
    }
    else
    {
        <!-- Weekly Timetable -->
        <div class="row g-4">

            @foreach (var day in days)
            {
                var classes = Model
                    .Where(x => x.Day == day)
                    .OrderBy(x => x.StartTime)
                    .ToList();

                <div class="col-xl-3 col-lg-4 col-md-6">

                    <div class="day-card">

                        <!-- Day Header -->
                        <div class="day-header">
                            <h5>
                                @day
                            </h5>
                        </div>


                        <!-- Day Content -->
                        <div class="day-body">

                            @if (!classes.Any())
                            {
                                <div class="empty-day">

                                    <div>
                                        <div class="empty-day-icon">
                                            💤
                                        </div>

                                        <div>
                                            No classes
                                        </div>
                                    </div>

                                </div>
                            }
                            else
                            {
                                @foreach (var item in classes)
                                {
                                    <div class="class-card">

                                        <!-- Subject -->
                                        <div class="subject-code">
                                            @item.SubjectCode
                                        </div>

                                        <div class="subject-name">
                                            @item.SubjectName
                                        </div>


                                        <hr class="class-divider" />


                                        <!-- Time -->
                                        <div class="time-badge">
                                            🕐
                                            @item.StartTime.ToString("HH:mm")
                                            -
                                            @item.EndTime.ToString("HH:mm")
                                        </div>


                                        <!-- Class -->
                                        <div class="class-info">
                                            🏫
                                            <strong>Class:</strong>
                                            @item.ClassCode
                                        </div>


                                        <!-- Room -->
                                        <div class="class-info">
                                            🚪
                                            <strong>Room:</strong>
                                            @item.Room
                                        </div>


                                        <!-- Teacher -->
                                        <div class="class-info">
                                            👨‍🏫
                                            <strong>Teacher:</strong>
                                            @item.TeacherName
                                        </div>

                                    </div>
                                }
                            }

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>